# 行尾统一 LF（避免 clone 到 Linux 后脚本/源码混入 CRLF）
* text=auto eol=lf

*.php  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.po   text eol=lf
*.pot  text eol=lf

# 二进制不转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
